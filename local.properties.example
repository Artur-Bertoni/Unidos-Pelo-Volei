# Copie este arquivo para local.properties e preencha.
# local.properties NAO vai para o controle de versao: e onde ficam as chaves.
#
# O prefixo escolhe o ambiente e casa com a build variant:
#   dev.*   -> variants devDebug / devRelease   (padrao no Android Studio)
#   prod.*  -> variants prodDebug / prodRelease
#
# As chaves entram no codigo via BuildConfig (ver app/build.gradle.kts).
# Em CI, as mesmas chaves podem vir de variaveis de ambiente no formato
# DEV_SUPABASE_URL, PROD_SUPABASE_URL e assim por diante.

# Caminho do Android SDK. O Android Studio preenche sozinho ao abrir o projeto.
sdk.dir=C\:\\Users\\SEU_USUARIO\\AppData\\Local\\Android\\Sdk

# ---------------------------------------------------------------------------
# Ambiente de desenvolvimento
# ---------------------------------------------------------------------------
dev.SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
dev.SUPABASE_ANON_KEY=
dev.POWERSYNC_URL=https://SUA-INSTANCIA-DEV.powersync.journeyapps.com
dev.GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Ambiente de producao
# ---------------------------------------------------------------------------
prod.SUPABASE_URL=
prod.SUPABASE_ANON_KEY=
prod.POWERSYNC_URL=
prod.GOOGLE_WEB_CLIENT_ID=

# Push (opcional). Sem estas quatro chaves o app funciona igual, so nao registra
# o aparelho para receber notificacao. Elas vem do Firebase console, em
# Configuracoes do projeto > Seus apps > app Android.
#
#   FIREBASE_PROJECT_ID  -> Project ID
#   FIREBASE_APP_ID      -> App ID (1:123...:android:abc...)
#   FIREBASE_API_KEY     -> Chave de API do Android
#   FIREBASE_SENDER_ID   -> Numero do remetente (Project number)
#
# A chave privada da conta de servico NAO entra aqui: ela e secret da Edge
# Function enviar-avisos, no painel do Supabase.

dev.FIREBASE_PROJECT_ID=
dev.FIREBASE_APP_ID=
dev.FIREBASE_API_KEY=
dev.FIREBASE_SENDER_ID=

prod.FIREBASE_PROJECT_ID=
prod.FIREBASE_APP_ID=
prod.FIREBASE_API_KEY=
prod.FIREBASE_SENDER_ID=
