# Copie para .env.development (ambiente de dev) e .env.production (producao).
# Nenhum dos dois vai para o Git: o .gitignore ja cobre web/.env*.
#
# No Railway estas variaveis ficam no servico "web" (ver .railway/railway.ts) e
# entram no build como ARG do Dockerfile. Localmente, o Vite le estes arquivos.

VITE_API_URL=http://localhost:3000
VITE_POWERSYNC_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# Chave publica VAPID do Web Push. Sem ela o app funciona, so nao registra push.
# A chave privada correspondente fica so no Railway (variavel VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=

# Aparece na tela de configuracao pendente. Opcional.
VITE_ENVIRONMENT=dev
