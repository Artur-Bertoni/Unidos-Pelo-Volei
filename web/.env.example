# Copie para .env.development (ambiente de dev) e .env.production (producao).
# Nenhum dos dois vai para o Git: o .gitignore ja cobre web/.env*.
#
# Sao as mesmas chaves do local.properties do app Android, com outro nome:
#   dev.SUPABASE_URL       -> VITE_SUPABASE_URL       (em .env.development)
#   prod.SUPABASE_URL      -> VITE_SUPABASE_URL       (em .env.production)
#
# O Vite le estes valores no momento do build e os embute no bundle, do mesmo
# jeito que o Gradle embute as chaves no .aab. Nao ha configuracao em servidor.
#
# Nao existe GOOGLE_WEB_CLIENT_ID aqui: na web o login usa o fluxo de
# redirecionamento do Supabase, que ja conhece o client configurado no painel.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_POWERSYNC_URL=https://SUA-INSTANCIA.powersync.journeyapps.com

# Chave publica VAPID do Web Push. Sem ela o app funciona, so nao registra push.
# A chave privada correspondente fica como secret da Edge Function, nunca aqui.
VITE_VAPID_PUBLIC_KEY=

# Aparece na tela de configuracao pendente. Opcional.
VITE_ENVIRONMENT=dev
