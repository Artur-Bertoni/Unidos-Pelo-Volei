# Copie para .env e preencha. O arquivo .env nao vai para o controle de versao.

# Porta em que o PowerSync self-hosted escuta na maquina.
PS_PORT=8080

# Postgres do Supabase local (supabase start). A porta padrao do Postgres da
# Supabase CLI e 54322. Do container, a maquina host e host.docker.internal.
PS_DATA_SOURCE_URI=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# JWT secret do Supabase local. Rode `supabase status` e copie o campo "JWT secret".
PS_SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
