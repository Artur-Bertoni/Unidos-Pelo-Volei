# Copie este arquivo para keystore.properties e preencha.
# keystore.properties NAO vai para o controle de versao: e onde ficam as senhas
# do keystore que assina o release publicado na Play Store.
#
# Enquanto este arquivo nao existir, o build type release sai sem assinatura --
# serve para rodar e depurar, mas a Play Store recusa o upload.
#
# Gerar o keystore (guarde fora da pasta do repositorio e faca backup:
# perder o arquivo ou a senha impede publicar atualizacoes do app):
#
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# O SHA-1 correspondente sai em `./gradlew signingReport`, na variant prodRelease,
# e precisa ser cadastrado no OAuth client Android do Google Cloud.

storeFile=C\:/Users/SEU_USUARIO/chaves/upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
