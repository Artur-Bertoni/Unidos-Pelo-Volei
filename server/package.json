{
  "name": "unidos-pelo-volei-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "avisos": "node dist/avisos.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "migrar-do-supabase": "tsx scripts/migrar-do-supabase.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "google-auth-library": "^11.3.4",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/web-push": "^3.6.4",
    "pg-copy-streams": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
